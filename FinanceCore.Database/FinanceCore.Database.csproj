<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="dbup-sqlserver" Version="7.2.0" />
	  <None Include="..\database\migrations\**\*.sql">
		  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		  <Link>migrations\%(RecursiveDir)%(Filename)%(Extension)</Link>
	  </None>

	  <None Include="..\database\procedures\**\*.sql">
		  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		  <Link>procedures\%(RecursiveDir)%(Filename)%(Extension)</Link>
	  </None>
  </ItemGroup>

</Project>
